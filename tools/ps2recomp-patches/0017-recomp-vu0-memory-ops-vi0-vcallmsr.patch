+    // VLQI.dest ft, (is++) / VLQD.dest ft, (--is): ft = bits 20-16 (rt), is = bits 15-11 (rd).
+    // VSQI.dest fs, (it++) / VSQD.dest fs, (--it): fs = bits 15-11 (rd), it = bits 20-16 (rt).
+    // The VI register steps by one quadword as a 16-bit register (vi0 stays 0: keepVi0Zero).
+    static std::string vu0QwordMove(bool load, bool predecrement, uint8_t vf, uint8_t vi, uint8_t dest_mask)
+    {
+        const std::string mask = fmt::format("_mm_castsi128_ps(_mm_set_epi32({}, {}, {}, {}))",
+                                             (dest_mask & 0x1) ? -1 : 0, (dest_mask & 0x2) ? -1 : 0,
+                                             (dest_mask & 0x4) ? -1 : 0, (dest_mask & 0x8) ? -1 : 0);
+        std::string code = "{ ";
+        if (predecrement)
+            code += fmt::format("const uint16_t index = static_cast<uint16_t>(ctx->vi[{}] - 1); ctx->vi[{}] = index; ", vi, vi);
+        else
+            code += fmt::format("const uint16_t index = ctx->vi[{}]; ", vi);
+        code += fmt::format("float *p = reinterpret_cast<float *>({}); ", vu0DataAddress(vi, "index"));
+        if (load)
+            code += fmt::format("ctx->vu0_vf[{}] = _mm_blendv_ps(ctx->vu0_vf[{}], _mm_loadu_ps(p), {}); ", vf, vf, mask);
+        else
+            code += fmt::format("_mm_storeu_ps(p, _mm_blendv_ps(_mm_loadu_ps(p), ctx->vu0_vf[{}], {})); ", vf, mask);
+        if (!predecrement)
+            code += fmt::format("ctx->vi[{}] = static_cast<uint16_t>(index + 1); ", vi);
+        return code + "}";
+    }
