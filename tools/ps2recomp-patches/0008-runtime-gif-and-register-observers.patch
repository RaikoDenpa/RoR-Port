@@ -115,6 +116,9 @@ public:
                            const uint8_t *data,
                            uint32_t sizeBytes);
     void writeRegister(uint8_t regAddr, uint64_t value);
+    // Sees each writeRegister call (register writes from runtime handlers, outside the GIF stream), after the write.
+    using RegisterObserverFn = std::function<void(uint8_t regAddr, uint64_t value)>;
+    void setRegisterObserver(RegisterObserverFn fn) { m_registerObserver = std::move(fn); }
 
     const uint8_t *lockDisplaySnapshot(uint32_t &outSize);
