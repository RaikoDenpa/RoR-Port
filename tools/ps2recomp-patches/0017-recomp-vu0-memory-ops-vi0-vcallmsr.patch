+    // Macro-mode VU0 memory operands: a quadword index from a VI register into VU0 data memory (4 KB, wrapping), not EE
+    // memory. The field of VILWR/VISWR selects the word: x (dest bit 3) +0 ... w (bit 0) +12.
+    static std::string vu0DataAddress(uint8_t vi, const char *index = nullptr)
+    {
+        return fmt::format("(runtime->memory().getVU0Data() + ((static_cast<uint32_t>({}) & 0xFFu) << 4))",
+                           index ? std::string(index) : fmt::format("ctx->vi[{}]", vi));
+    }
+
+    static uint32_t vu0FieldOffset(uint8_t dest_mask)
+    {
+        return (dest_mask & 0x8) ? 0u : (dest_mask & 0x4) ? 4u : (dest_mask & 0x2) ? 8u : 12u;
+    }
+
     std::string CodeGenerator::translateVU_VILWR(const Instruction &inst)
     {
-        return fmt::format("{{ uint32_t addr = (uint32_t)(ctx->vi[{}] << 2) & 0x3FFC; ctx->vi[{}] = static_cast<uint16_t>(READ32(addr)); }}", inst.rd, inst.rt); // VILWR.<f> vit, (vis)
+        // VILWR.<f> vit, (vis): it = bits 20-16 (rt), is = bits 15-11 (rd); the low 16 bits of the word.
+        return fmt::format("{{ uint32_t w; std::memcpy(&w, {} + {}, 4); ctx->vi[{}] = static_cast<uint16_t>(w); }}",
+                           vu0DataAddress(inst.rd), vu0FieldOffset(inst.vectorInfo.vectorField), inst.rt);
     }
 
     std::string CodeGenerator::translateVU_VISWR(const Instruction &inst)
     {
-        return fmt::format("{{ uint32_t addr = (uint32_t)(ctx->vi[{}] << 2) & 0x3FFC; WRITE32(addr, (uint32_t)ctx->vi[{}]); }}", inst.rd, inst.rt); // VISWR.<f> vit, (vis)
+        // VISWR.<f> vit, (vis): stores vit zero-extended to 32 bits.
+        return fmt::format("{{ uint32_t w = ctx->vi[{}]; std::memcpy({} + {}, &w, 4); }}",
+                           inst.rt, vu0DataAddress(inst.rd), vu0FieldOffset(inst.vectorInfo.vectorField));
     }
 
